{
  "swagger": "2.0",
  "info": {
    "title": "ClinicPass V2 Staff Actions",
    "description": "Provisional administrative eligibility actions. Never use for clinical decisions, remote identity or e-card verification, or coverage/reimbursement guarantees.",
    "version": "2.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/api/v1/copilot",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "oauth2": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "scopes": {"api://REPLACE_WITH_APP_ID/ClinicPass.Access": "Use ClinicPass as the signed-in clinic staff member"}
    }
  },
  "security": [{"oauth2": ["api://REPLACE_WITH_APP_ID/ClinicPass.Access"]}],
  "paths": {
    "/cases": {"get": {"operationId": "searchCases", "summary": "Search clinic cases", "parameters": [{"name": "search", "in": "query", "type": "string"}, {"name": "status", "in": "query", "type": "string"}], "responses": {"200": {"description": "Matching clinic-scoped cases"}}}},
    "/cases/{case_id}/summary": {"get": {"operationId": "getCaseSummary", "summary": "Get masked case summary", "parameters": [{"$ref": "#/parameters/CaseId"}], "responses": {"200": {"description": "Case summary"}}}},
    "/cases/{case_id}/evaluation": {"get": {"operationId": "getEligibilityEvaluation", "summary": "Get or refresh eligibility evaluation", "parameters": [{"$ref": "#/parameters/CaseId"}], "responses": {"200": {"description": "Versioned evaluation and findings"}}}},
    "/cases/{case_id}/findings": {"get": {"operationId": "explainFindings", "summary": "Explain deterministic findings", "parameters": [{"$ref": "#/parameters/CaseId"}], "responses": {"200": {"description": "PASS, REVIEW and FAIL findings"}}}},
    "/cases/{case_id}/evidence/{document_id}": {"get": {"operationId": "locateFieldEvidence", "summary": "Locate field assertions and grounded evidence", "parameters": [{"$ref": "#/parameters/CaseId"}, {"name": "document_id", "in": "path", "required": true, "type": "string"}], "responses": {"200": {"description": "Authorized evidence"}}}},
    "/cases/{case_id}/export-status": {"get": {"operationId": "getExportStatus", "summary": "Get canonical export status", "parameters": [{"$ref": "#/parameters/CaseId"}], "responses": {"200": {"description": "Latest export attempt"}}}},
    "/cases/{case_id}/patient-request/draft": {"post": {"operationId": "draftPatientRequest", "summary": "Draft without sending", "parameters": [{"$ref": "#/parameters/CaseId"}], "responses": {"200": {"description": "Draft requiring confirmation"}}}},
    "/cases/{case_id}/correction/draft": {"post": {"operationId": "draftCorrectionNote", "summary": "Draft a correction note", "parameters": [{"$ref": "#/parameters/CaseId"}, {"$ref": "#/parameters/CorrectionBody"}], "responses": {"200": {"description": "Draft requiring confirmation"}}}},
    "/cases/{case_id}/patient-request": {"post": {"operationId": "submitPatientRequest", "summary": "Submit a confirmed patient request", "parameters": [{"$ref": "#/parameters/CaseId"}, {"name": "body", "in": "body", "required": true, "schema": {"$ref": "#/definitions/ReviewAction"}}], "responses": {"200": {"description": "Updated case"}}}},
    "/cases/{case_id}/assertions/{assertion_id}": {"patch": {"operationId": "recordCorrection", "summary": "Record an audited correction", "parameters": [{"$ref": "#/parameters/CaseId"}, {"name": "assertion_id", "in": "path", "required": true, "type": "string"}, {"$ref": "#/parameters/CorrectionBody"}], "responses": {"200": {"description": "Corrected assertion; eligibility stale"}}}},
    "/cases/{case_id}/override-requests": {"post": {"operationId": "requestOverride", "summary": "Request manager review of one finding", "parameters": [{"$ref": "#/parameters/CaseId"}, {"name": "body", "in": "body", "required": true, "schema": {"$ref": "#/definitions/OverrideRequest"}}], "responses": {"200": {"description": "Override request"}}}},
    "/cases/{case_id}/decision": {"post": {"operationId": "recordDecision", "summary": "Record a freshness-gated decision", "parameters": [{"$ref": "#/parameters/CaseId"}, {"name": "body", "in": "body", "required": true, "schema": {"$ref": "#/definitions/ReviewAction"}}], "responses": {"200": {"description": "Updated case"}}}},
    "/cases/{case_id}/export": {"post": {"operationId": "retryExport", "summary": "Create or replay an idempotent export", "parameters": [{"$ref": "#/parameters/CaseId"}, {"name": "Idempotency-Key", "in": "header", "required": true, "type": "string", "minLength": 8}], "responses": {"200": {"description": "Export acceptance or replay"}}}}
  },
  "parameters": {
    "CaseId": {"name": "case_id", "in": "path", "required": true, "type": "string", "description": "ClinicPass case UUID"},
    "CorrectionBody": {"name": "body", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Correction"}}
  },
  "definitions": {
    "ReviewAction": {"type": "object", "required": ["action", "reason"], "properties": {"action": {"type": "string", "enum": ["request_information", "approve", "cancel"]}, "reason": {"type": "string", "minLength": 3}, "override_failures": {"type": "boolean", "enum": [false], "description": "Inline overrides are prohibited"}}},
    "Correction": {"type": "object", "required": ["corrected_value", "reason"], "properties": {"corrected_value": {"type": "string"}, "reason": {"type": "string", "minLength": 3}}},
    "OverrideRequest": {"type": "object", "required": ["finding_id", "reason"], "properties": {"finding_id": {"type": "string"}, "reason": {"type": "string", "minLength": 5}}}
  }
}
