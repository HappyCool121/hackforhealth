# The fixture provider is deterministic and safe for local development and CI.
# Switch to agnes for the live judging demo and supply the API key out of band.
AI_PROVIDER=fixture
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_API_KEY=
AGNES_TIMEOUT_SECONDS=45
DATABASE_URL=
POSTGRES_PASSWORD=
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=/data/uploads
PORT=8000
COOKIE_SECURE=false
CLINICPASS_V2_ENABLED=true
CSRF_ENABLED=true
ENCRYPTION_KEY=
IDENTITY_HMAC_KEY=
UPLOAD_SCANNER=deterministic_demo
UPLOAD_SCAN_REQUIRED=true
RETENTION_DAYS=30
CLINIC_ASSIST_URL=http://mock-clinic-assist:8090/api/v1/patients
CLINIC_ASSIST_SECRET=
BACKEND_GATEWAY_SECRET=
SMTP_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
STAFF_ASSISTANT_EMAIL=assistant@clinicpass.test
STAFF_ASSISTANT_PASSWORD=
STAFF_MANAGER_EMAIL=manager@clinicpass.test
STAFF_MANAGER_PASSWORD=
SHOW_DEMO_CREDENTIALS=true
