# The fixture provider is deterministic and safe for local development and CI.
# Switch to agnes for the live judging demo and supply the API key out of band.
AI_PROVIDER=fixture
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_API_KEY=
AGNES_TIMEOUT_SECONDS=45
DATABASE_URL=postgresql+psycopg://clinicpass:clinicpass@postgres:5432/clinicpass
SESSION_SECRET=replace-this-for-any-shared-environment
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=/data/uploads
CLINIC_ASSIST_URL=http://mock-clinic-assist:8090
SMTP_HOST=mailpit
SMTP_PORT=1025

